BB_VBLANK_HZ=240
ISS_AOT_COMPUTE=auto
ISS_AOT_INDEX=auto
ISS_AOT_RECIPES=1
ISS_AOT_WAIT=1
ISS_ASYNC_COMPUTE=0
ISS_BARRIER_POOL=1
ISS_CAPTURE_FRAMES=0
ISS_CAPTURE_OVERLAY=0
ISS_COMMAND_TRACE=0
ISS_COMPUTE_FAIRNESS=1
ISS_COMPUTE_PHASES=0
ISS_CPU_BUNDLE_INDEX_ONCE=0
ISS_CPU_BUNDLE_SPV_VERIFIED=0
ISS_CP_CPU=auto
ISS_CP_SPLIT=0
ISS_DEEP_PROFILE=0
ISS_DESCRIPTOR_DELTAS=0
ISS_DESCRIPTOR_FAST_PATH=1
ISS_DIAGNOSTIC_SESSION=0
ISS_DRAW_PIPE=0
ISS_ENGINE_MARKERS=0
ISS_ENGINE_STATS=0
ISS_FAST_DRAW=1
ISS_FAST_DYN_EXT=1
ISS_FAST_LEAN=1
ISS_FAST_PROGRAM_ALIAS=1
ISS_FAST_REBIND=1
ISS_FAST_STATE_SWITCH=1
ISS_FAST_SWITCH=1
ISS_FAULT_WINDOW_KB=64
ISS_FEEDBACK_EARLY_SUBMIT=0
ISS_FEEDBACK_IDENTITY=0
ISS_FEEDBACK_JOIN=0
ISS_FEEDBACK_PAGE_READBACK=0
ISS_FEEDBACK_TRACE=0
ISS_G4_FEEDBACK_PROBE=0
# 0: no GPU black box (no VK_AMD_buffer_marker writes per marked GPU command); measured +3.0% FPS
# [95% CI +1.6,+4.4] on the bench route. To report a GPU hang, run with ISS_GPU_BLACKBOX=1: the run
# folder then gets gpu-stall-N.txt / gpu-crash.txt (gpu/gpu_blackbox.h). Unset outside this file: on.
ISS_GPU_BLACKBOX=0
ISS_GPU_HAZARD_DIAG=0
ISS_GPU_PROFILE=0
ISS_HYBRID_BENCH_HIDDEN=0
ISS_HYBRID_FAMILY_PROFILE=0
ISS_LAZY_PIPELINES=1
# 1: stdout/stderr fully buffered (64 KB), written out every 200 ms and on every exit/crash path,
# instead of one write per character (src/probe.c log_buffer_start). 0: unbuffered (old behavior).
# Default 1 together with ISS_MINIMAL_LOGS, ISS_NATIVE_STATS_INTERVAL_MS, ISS_PENDING_OPS_PRIO and
# ISS_UPLOAD_IDLE below: +5.3% FPS [95% CI +2.5,+8.1], 1% low +11% on the bench route.
ISS_LOG_BUFFER=1
# 1: the per-event GPU lines (arena ranges made resident, clamped buffer bindings) become counts,
# one RESIDENT_RANGES / BUFFER_CLAMP_LINES summary per 5 s after the first lines (gpu/minimal_logs.h).
ISS_MINIMAL_LOGS=1
ISS_MUTEX_SPIN_US=20
ISS_NATIVE_CITY_FETCH=0
ISS_NATIVE_CPU_DRAWS=0
ISS_NATIVE_DEPTH_RUN=0
ISS_NATIVE_DRAW_STATE=0
ISS_NATIVE_DRAW_STATE_VERIFY=0
ISS_NATIVE_FEEDBACK_PROBE=0
ISS_NATIVE_GBUFFER_SETS=1
ISS_NATIVE_INDEXED_BATCH=0
ISS_NATIVE_INSTANCED_BATCH=0
ISS_NATIVE_ASC_ASYNC=1
ISS_NATIVE_INSTANCED_FEATURE=1
ISS_NATIVE_ITEMS=0
ISS_NATIVE_ITEM_RANGES=0
ISS_NATIVE_MATERIALS=1
ISS_NATIVE_MEMORY_REPORT=0
# Launcher runs (and bench.ps1, which runs the launcher): replaced by the launcher's "Native passes"
# switch (backports_table.py native_passes: on on Windows, off on Linux). play_v2.sh sets its own
# 0 before it reads this file, so this 1 is not what either of them runs with.
ISS_NATIVE_PASSES=1
ISS_NATIVE_PASSES_ASYNC_SCAN=1
ISS_NATIVE_PASSES_DYNAMIC=1
ISS_NATIVE_PASSES_SUBMIT=1
ISS_NATIVE_READBACK_PAGES=0
ISS_NATIVE_SHADOW=0
ISS_NATIVE_SHADOW_STATS=0
ISS_NATIVE_SHADOW_VERIFY=0
# N > 0: the NATIVE_PASSES_* / NATIVE_COMPUTE reports at most once per N ms each (e.g. 5000) instead
# of every 1024 segments (~9 a second on the command processor). 0: by count (old behavior).
ISS_NATIVE_STATS_INTERVAL_MS=5000
ISS_NATIVE_VERIFY=0
ISS_PARALLEL_RENDER=1
# 1 (with ISS_THREAD_PRIORITY=1, Windows): the GPU thread that writes the deferred labels, EOPs and
# interrupts the guest waits on also runs above normal priority. 0: normal (old behavior).
ISS_PENDING_OPS_PRIO=1
ISS_PIPELINE_EVENTS=0
ISS_PIPELINE_STATE_REUSE=0
ISS_PIPELINE_STATE_REUSE_STATS=0
ISS_PIPELINE_STATE_REUSE_VERIFY=0
ISS_PRELOAD_BACKGROUND=1
ISS_PREWARM_LARGE_UPLOAD=0
ISS_PROBE_HOST_IMPORT=0
ISS_READBACK_DIAG=0
ISS_REAL_OCCLUSION=1
ISS_RENDER_REUSE=1
ISS_RING_BARRIERS=1
ISS_SECONDARY_BATCH_PROBE=0
ISS_SMALL_READ_MEMO=0
ISS_SPEC_TRANSLATE=1
ISS_STAGE_MEMO=1
ISS_STAGE_MEMO_LOOSE=1
ISS_STAGE_MEMO_TEXEL=1
ISS_SUBMIT_EVERY=1000
# 500: the batch is also submitted once recorded for 500 us (clamped to 100-100000; 0: off), so the
# readbacks go to the readback queue instead of waiting for the work recorded before them: measured
# +18% FPS on the bench route (2026-10-26 audit). Startup line: PORT_TUNING submit_interval_us=N.
ISS_SUBMIT_INTERVAL_US=500
ISS_TEXTURE_LOOKUP_MEMO=0
ISS_TEXTURE_LOOKUP_MEMO_STATS=0
ISS_THREAD_PRIORITY=1
ISS_TIMELINE=0
ISS_TRACE_READBACK=0
# An ISS_TUNING set outside this file (a bench.ps1 variant, a shell) is merged with this one per key
# (launcher: infamous_run.merge_tuning). Any key here: ISS_X=__unset__ runs without it.
ISS_TUNING=async_written_uploads=1,scout=1,scout_fast=1,bind_prefetch=1
ISS_UNIFIED_FLUSH_IRQ=0
ISS_UNIFIED_FLUSH_US=1000
# Launcher runs (and bench.ps1, which runs the launcher): replaced by the launcher's "Unified memory"
# switch (backports_table.py v2_unified_memory), so effectively 0 on Windows (and 1 on Linux) unless
# the player changes it. Only play_v2.sh and a shell that exports it use this 1.
ISS_UNIFIED_MEMORY=1
# sleep: the upload worker sleeps between jobs (1 ms high resolution timer, woken by the command
# processor at 8 queued jobs) instead of the old 1 ms timed wait, which spins a core on Windows.
# Anything else (poll): the old wait.
ISS_UPLOAD_IDLE=sleep
ISS_UPLOAD_WORKER=1
ISS_VBLANK_TIMER=legacy
ISS_VISUAL_SEQUENCE=0
SHADPS4_FAST_STAGE_LOOKUP=1
SHADPS4_PARALLEL_PRELOAD=1
SHADPS4_REUSE_DESCRIPTOR_STORAGE=1
ISS_UNIFIED_RANGE=0x1048000000:0x20000000
# Blended draws into this color target stay on the command processor: the pause menu reuses it as its
# UI layer and native blended segments there hung the GPU. Castlesea's default 203d70000 is in its heap
# C (0x200000000); this port's runtime maps heap C at 0x1068000000, the same target is at 0x106BD70000.
ISS_NATIVE_PASSES_BLEND_DENY=106BD70000
